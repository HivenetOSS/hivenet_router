    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of total requests per model for this tenant. Bar length shows percentage of total; value label shows percentage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.model}"
        }
      },
      "gridPos": {
