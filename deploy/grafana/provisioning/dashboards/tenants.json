    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Estimated time until the daily token quota is exhausted at the current consumption rate (based on last 10 min). Shows N/A when the tenant is idle.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          },
          "unit": "h",
          "noValue": "N/A (idle)"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 19,
        "y": 13
      },
      "id": 18,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "Token Budget Runway",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(hivenet_router_tenant_quota_tpd_limit{tenant_id=~\"$tenant_id\"}) - sum(hivenet_router_tenant_tokens_used_today{tenant_id=~\"$tenant_id\"})) / clamp_min(sum(rate(hivenet_router_tenant_input_tokens_total{tenant_id=~\"$tenant_id\"}[10m])) + sum(rate(hivenet_router_tenant_output_tokens_total{tenant_id=~\"$tenant_id\"}[10m])), 0.001) / 3600) and on() (sum(hivenet_router_tenant_quota_tpd_limit{tenant_id=~\"$tenant_id\"}) > 0)",
          "legendFormat": "Hours remaining",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tokens remaining in today's budget. Shown only when a limit is configured.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "text": "Unlimited"
                }
              },
              "type": "special"
            }
          ]
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 5,
        "y": 17
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "Tokens Remaining Today",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum(hivenet_router_tenant_quota_tpd_limit{tenant_id=~\"$tenant_id\"}) - sum(hivenet_router_tenant_tokens_used_today{tenant_id=~\"$tenant_id\"}), 0) and on() sum(hivenet_router_tenant_quota_tpd_limit{tenant_id=~\"$tenant_id\"}) > 0",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rate of prompt and completion token consumption over time.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
