# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM golang:1.25 AS builder

# go-nvml uses RTLD_DEEPBIND (glibc-only) — requires a glibc-based image.
# golang:1.25 is Debian-based and includes gcc + glibc out of the box.

WORKDIR /app

# Download dependencies first (cached layer unless go.mod/go.sum change)
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the agent binary.
# CGO_ENABLED=1 is required by go-nvml (uses dlopen + RTLD_DEEPBIND at runtime).
COPY . .
ARG GIT_COMMIT=dev
RUN CGO_ENABLED=1 GOOS=linux go build -trimpath \
    -ldflags="-X hivenet_router/internal/config.BuildVersion=${GIT_COMMIT}" \
    -o /hivenet-agent ./cmd/agent/

# Collect the license texts of all statically-linked dependencies so they
# travel with the image (Go links deps into the binary — see the script).
RUN OUT=/licenses ./scripts/collect-licenses.sh ./cmd/agent

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
# debian:bookworm-slim provides glibc required by the CGO-linked binary.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /hivenet-agent .

# Third-party dependency licenses (Apache-2.0/MIT/BSD attribution for the
# statically-linked deps). The project's own LICENSE is Apache-2.0.
COPY --from=builder /licenses /licenses

# Identity key is persisted via a volume mount so the agent keeps
# the same peer ID across container restarts.
VOLUME ["/app/data"]

# libp2p P2P port — must match --p2p-listen-port and the host port mapping.
EXPOSE 9001

# ── Environment variables (override via docker run -e or compose environment) ─
# AGENT_ENGINE          vllm | ollama | sglang | custom   (default: vllm)
# AGENT_BACKEND_URL     http://host.docker.internal:8888
# AGENT_ROUTER_GRPC     host:port
# AGENT_ROUTER_P2P      /dns4/<host>/tcp/<port>
# AGENT_P2P_ANNOUNCE    /ip4/<HOST_IP>/tcp/<MAPPED_PORT>   ← required in Docker
# AGENT_CAPACITY        10
# AGENT_REGION          EU-France
# AGENT_MODEL           (empty = auto-detect)

ENTRYPOINT ["/app/hivenet-agent"]
